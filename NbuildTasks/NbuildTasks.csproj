<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<CurrentYear>$([System.DateTime]::Now.ToString('yyyy'))</CurrentYear>
	<Version></Version>
	<AssemblyVersion></AssemblyVersion>
	<Authors>naz-hage</Authors>
	<Company>naz-hage</Company>
	<Product>Build automation</Product>
	<Copyright>2020-$(CurrentYear)</Copyright>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
	<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<AllowedOutputExtensionsInPackageBuildOutputFolder Remove=".pdb" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <PackageReference Include="sdo-launcher" Version="1.17.10" />
  </ItemGroup>

</Project>
